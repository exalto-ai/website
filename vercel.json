{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "headers": [
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(favicon.svg|pot-mark-white.svg|pot-mark-blue.svg|pot-tile.svg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(art|icons)/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/s/:traceId",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/traces",
      "destination": "/tools.html"
    },
    {
      "source": "/registry",
      "destination": "/tools.html"
    },
    {
      "source": "/verify",
      "destination": "/tools.html"
    },
    {
      "source": "/s/:traceId",
      "destination": "/tools.html"
    }
  ]
}
