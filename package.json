{
  "name": "@exalto/website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run check:copy && npm run check:types && vite build",
    "check:copy": "node scripts/check-copy.mjs",
    "test:redirects": "node scripts/test-vercel-config.mjs",
